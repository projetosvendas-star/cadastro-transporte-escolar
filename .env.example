# ============================================================
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA envie ".env", ".env.local" ou ".env.production" para o Git.
# ============================================================

# URL do projeto Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (ANON/PUBLISHABLE) — pode ser usada no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de SERVIÇO (service_role) — PRIVADA.
# NUNCA use o prefixo NEXT_PUBLIC_ e NUNCA exponha no navegador.
# Usada apenas pelas Vercel Functions em /api (lado do servidor).
SUPABASE_SERVICE_ROLE_KEY=

# Secret do endpoint /api/keep-alive.
# Na Vercel, configure com o MESMO valor de CRON_SECRET para que
# o cron consiga autenticar automaticamente (Authorization: Bearer).
# Gere com: openssl rand -hex 32
KEEP_ALIVE_SECRET=

# Secret dos cron jobs da Vercel.
# Quando definido, a Vercel envia "Authorization: Bearer <CRON_SECRET>"
# automaticamente a cada invocação do cron.
CRON_SECRET=